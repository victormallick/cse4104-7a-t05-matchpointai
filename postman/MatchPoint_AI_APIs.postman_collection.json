{
  "info": {
    "_postman_id": "8b5d30d1-6785-4078-a8bf-3f41ff622a5e",
    "name": "MatchPoint AI API",
    "description": "CSE4104-7A-T05 MatchPoint AI backend requests. Works with local demo mode or configured Supabase credentials.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "API Health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/health"
          }
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Jane Doe\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{base_url}}/api/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success && json.data) {",
                  "  pm.collectionVariables.set('jwt_token', json.data.session.access_token);",
                  "  pm.collectionVariables.set('user_id', json.data.user_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"amina.rahman@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{base_url}}/api/auth/login"
          }
        },
        {
          "name": "Admin Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@matchpoint.ai\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{base_url}}/api/auth/login"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": "{{base_url}}/api/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Candidate Profile",
      "item": [
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": "{{base_url}}/api/user/profile"
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"full_name\": \"Amina Rahman\",\n  \"target_job_role\": \"Frontend Software Engineer\",\n  \"portfolio_url\": \"https://portfolio.example.com\"\n}"
            },
            "url": "{{base_url}}/api/user/profile"
          }
        },
        {
          "name": "Analysis History",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
            ],
            "url": "{{base_url}}/api/user/history"
          }
        }
      ]
    },
    {
      "name": "Resume Analysis Flow",
      "item": [
        {
          "name": "Upload Resume",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success) pm.collectionVariables.set('resume_id', json.data.resume_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "X-User-Id", "value": "{{user_id}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "resume", "type": "file", "src": [] },
                { "key": "user_id", "type": "text", "value": "{{user_id}}" }
              ]
            },
            "url": "{{base_url}}/api/upload"
          }
        },
        {
          "name": "Gap Analysis",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success) pm.collectionVariables.set('analysis_id', json.data.analysis_id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{user_id}}\",\n  \"resume_id\": \"{{resume_id}}\",\n  \"job_title\": \"Full Stack Engineer\",\n  \"company\": \"CloudGrid\",\n  \"jd_text\": \"Build React and TypeScript applications with Node.js, PostgreSQL, Docker, CI/CD, Jest, Redis, and Agile delivery practices.\"\n}"
            },
            "url": "{{base_url}}/api/analysis/gap-analysis"
          }
        },
        {
          "name": "Generate Interview Questions",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"analysis_id\": \"{{analysis_id}}\",\n  \"user_id\": \"{{user_id}}\"\n}"
            },
            "url": "{{base_url}}/api/interview/generate"
          }
        },
        {
          "name": "Job Recommendations",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/jobs/recommendations?user_id={{user_id}}"
          }
        }
      ]
    },
    {
      "name": "Admin Monitoring",
      "item": [
        {
          "name": "System Analytics",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer demo-admin-token" }
            ],
            "url": "{{base_url}}/api/admin/analytics"
          }
        },
        {
          "name": "Manage Users",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer demo-admin-token" }
            ],
            "url": "{{base_url}}/api/admin/users"
          }
        },
        {
          "name": "AI Usage",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer demo-admin-token" }
            ],
            "url": "{{base_url}}/api/admin/ai-usage"
          }
        },
        {
          "name": "Admin Logs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer demo-admin-token" }
            ],
            "url": "{{base_url}}/api/admin/logs"
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:5000" },
    { "key": "jwt_token", "value": "demo-user-token" },
    { "key": "user_id", "value": "11111111-1111-4111-8111-111111111111" },
    { "key": "resume_id", "value": "" },
    { "key": "analysis_id", "value": "" }
  ]
}
